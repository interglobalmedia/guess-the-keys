{
	"name": "guess-the-keys",
	"version": "1.0.0",
	"description": "A fun little game made with JavaScript, SCSS/CSS3, and HTML.",
	"scripts": {
		"lint": "eslint . --quiet --fix",
		"stylelint": "stylelint \"styles/scss/**/*.scss\"",
		"stylelint:fix": "stylelint --fix \"styles/scss/**/*.scss\"",
		"eslint:fix": "eslint . --fix",
		"format": "npm run prettier -- --write",
		"prepare": "husky",
		"prettier": "prettier --check \"**/*.+(js|jsx|json|yml|yaml|css|less|scss|ts|tsx|md|graphql|mdx)\"",
		"validate": "npm run lint && npm run stylelint && npm run prettier && npm run test:run",
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest",
		"test:run": "vitest run",
		"coverage": "vitest run --coverage"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/interglobalmedia/guess-the-keys.git"
	},
	"author": "Maria D. Campbell",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/interglobalmedia/guess-the-keys/issues"
	},
	"homepage": "https://interglobalmedia.github.io/guess-the-keys/",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@vitest/coverage-istanbul": "^4.1.10",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-prettier": "^5.5.6",
		"globals": "^17.11.0",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"sass": "^1.103.1",
		"stylelint": "^17.14.1",
		"stylelint-config-standard-scss": "^17.0.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	}
}
