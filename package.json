{
  "name": "guess-the-keys",
  "version": "1.0.0",
  "description": "A fun little game made with JavaScript, SCSS/CSS3, and HTML.",
  "scripts": {
    "lint": "eslint --quiet --fix --ext .mjs",
    "stylelint1": "stylelint **/*.scss",
    "stylelint": "stylelint **/*.css",
    "stylelint:fix": "stylelint --fix **/*.scss",
    "eslint:fix": "eslint . --fix",
    "eslint-check": "eslint --print-config . | eslint-config-prettier-check",
    "format": "npm run prettier -- --write",
    "prepare": "husky install",
    "prettier": "prettier \"**/*.+(js|jsx|json|yml|yaml|css|less|scss|ts|tsx|md|graphql|mdx)\"",
    "validate": "npm run lint && npm run stylelint && npm run prettier",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interglobalmedia/guess-the-keys.git"
  },
  "author": "Maria D. Campbell",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/interglobalmedia/guess-the-keys/issues"
  },
  "homepage": "https://interglobalmedia.github.io/guess-the-keys/",
  "devDependencies": {
    "eslint": "^8.7.0",
    "eslint-cli": "^1.1.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-prettier": "^4.0.0",
    "htmlhint": "^1.1.4",
    "husky": "^7.0.4",
    "jsdom": "^30.0.1",
    "prettier": "^2.5.1",
    "stylelint": "^14.3.0",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-prettier-scss": "^0.0.1",
    "stylelint-config-standard": "^24.0.0",
    "stylelint-config-standard-scss": "^3.0.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "sass": "^1.60.0"
  }
}
